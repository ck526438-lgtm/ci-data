{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck526438-lgtm.github.io/ci-data/schema.json",
  "title": "ci-data — Subdivision administrative de la Côte d'Ivoire",
  "type": "object",
  "required": ["code", "name", "level", "source", "confidence"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^CI-(AB|YM|BS|CM|DN|GD|LC|LG|MG|SM|SV|VB|WR|ZZ)(-[0-9]{2}){0,3}(-C[0-9]{2})?$",
      "description": "Code ci-data : CI-<district ISO 3166-2>[-<région>[-<département>[-<sous-préfecture|C+commune>]]]"
    },
    "name": { "type": "string", "minLength": 2 },
    "level": { "enum": ["district", "region", "department", "sub_prefecture", "commune"] },
    "parent": { "type": ["string", "null"], "description": "Code du niveau supérieur (null pour les districts)" },
    "capital": { "type": ["string", "null"], "description": "Chef-lieu" },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "area_km2": { "type": ["number", "null"], "minimum": 0 },
    "population": { "type": ["integer", "null"], "minimum": 0 },
    "confidence": {
      "enum": ["official", "derived"],
      "description": "official = reprise directe de la source amont ; derived = rattachement déduit, à confirmer"
    },
    "source": { "type": "string", "minLength": 8, "description": "Source amont (INS/RGPH, OCHA COD, ISO 3166-2, Wikipédia, Wikidata)" }
  },
  "additionalProperties": false
}
